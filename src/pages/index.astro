---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 5);

const dateFormatter = new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout title="OJ Raqueño">
  <section class="hero">
    <p class="hero-kicker">.NET · full-stack · design</p>
    <h1>Notes on software design.</h1>
    <p>
      How-tos and design decisions, with companion repos when an idea needs code.
    </p>
    <div class="cta-row">
      <a class="button button-primary" href="/blog">Read the blog</a>
      <a class="button button-ghost" href="/about">About</a>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Recent posts</h2>
      <a href="/blog">All posts →</a>
    </div>
    <ul class="post-list">
      {
        posts.map((post) => (
          <li class="post-item">
            <a href={`/blog/${post.id}/`}>
              <time datetime={post.data.publishedAt.toISOString()}>
                {dateFormatter.format(post.data.publishedAt)}
              </time>
              <div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <div class="tag-row">
                  {post.data.tags.slice(0, 2).map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
