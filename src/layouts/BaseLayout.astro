---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  path?: string;
}

const {
  title,
  description = 'Software design, .NET, and practical engineering notes from OJ Raqueño.',
  path = Astro.url.pathname,
} = Astro.props;

const pageTitle = title === 'OJ Raqueño' ? title : `${title} · OJ Raqueño`;
const currentPath = (path.replace(/\/+$/, '') || '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e6a75" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700&family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:opsz,ital,wght@8..60,0,400;8..60,0,600;8..60,1,400&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="site-shell header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">OJ</span>
          OJ Raqueño
        </a>
        <nav class="nav" aria-label="Primary">
          <a href="/blog" aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}
            >Blog</a
          >
          <a href="/about" aria-current={currentPath === '/about' ? 'page' : undefined}
            >About</a
          >
          <a href="https://github.com/ojraqueno" rel="noopener noreferrer"
            >GitHub</a
          >
        </nav>
      </div>
    </header>

    <div class="site-shell">
      <main id="content">
        <slot />
      </main>

      <footer class="site-footer">
        <p>OJ Raqueño · .NET, full-stack, and software design.</p>
        <div class="footer-links">
          <a href="https://github.com/ojraqueno" rel="noopener noreferrer">GitHub</a>
          <a href="https://www.linkedin.com/in/ojraqueno/" rel="noopener noreferrer"
            >LinkedIn</a
          >
        </div>
      </footer>
    </div>
  </body>
</html>
